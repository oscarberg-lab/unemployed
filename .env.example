# Copy to .env.local and fill in. One model key (Gemini or Claude) is required.

# Free option: Google Gemini's free tier. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest   # free-tier limits differ per model; Flash-Lite allows the most requests
# GEMINI_MIN_INTERVAL_MS=5000             # pause between requests, to stay under the per-minute limit

# Paid option: Claude. Used instead of Gemini when set (or force with LLM_PROVIDER).
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5              # a smaller model makes the daily grading much cheaper
# LLM_PROVIDER=gemini                     # "gemini" or "anthropic"; only needed if both keys are set

# Optional: hosted Postgres (Neon, Supabase, ...). Needed for the scheduled daily run.
# Without it the app stores everything in ./.data on this machine.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Optional: daily email digest through Resend (https://resend.com).
# RESEND_API_KEY=
# DIGEST_TO=you@example.com
# DIGEST_FROM=Job matches <jobs@yourdomain.com>
# APP_URL=https://your-deployment.example.com

# Set both for any public deployment.
# APP_PASSWORD=          # browser asks for this (any username)
# CRON_SECRET=           # bearer token for GET /api/cron

# Optional: how many new postings are graded per run (default 40). The rest wait for the next run.
# MAX_SCORED_PER_RUN=40
